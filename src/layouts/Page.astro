---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} — ${SITE_TITLE}`} description={description} />
		<style>
			.page-head {
				text-align: center;
				padding: 3.5em 1em 0.5em;
			}
			.page-head h1 {
				font-size: 2.8em;
				margin-bottom: 0.2em;
			}
			.page-body {
				width: 760px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 1.5em 1em 4em;
			}
			.page-body h2 {
				font-size: 1.5em;
				margin-top: 2em;
			}
			.page-body h3 {
				font-size: 1.2em;
				margin-top: 1.75em;
			}
			.page-body ul {
				color: var(--muted);
				padding-left: 1.4em;
			}
			.page-body li {
				margin-bottom: 0.5em;
			}
			.updated {
				text-align: center;
				color: var(--muted);
				font-size: 0.9rem;
				margin-top: 3em;
			}
			@media (max-width: 720px) {
				.page-head h1 {
					font-size: 2.1em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-head">
				{eyebrow && <span class="eyebrow">{eyebrow}</span>}
				<h1>{title}</h1>
			</div>
			<div class="page-body">
				<slot />
				<p class="updated">Last updated: October 15, 2026</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
