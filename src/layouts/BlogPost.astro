---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import { SITE_OG_IMAGE, SITE_TITLE, VERDICTS, type Verdict } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, verdict, category } = Astro.props;

const pageURL = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'NewsArticle',
	headline: title,
	description: description,
	image: [SITE_OG_IMAGE],
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: {
		'@type': 'Organization',
		name: SITE_TITLE,
		url: Astro.site?.toString(),
	},
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		url: Astro.site?.toString(),
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': pageURL,
	},
};

// ClaimReview structured data for fact-check articles.
const claimReview =
	verdict && verdict in VERDICTS
		? {
				'@context': 'https://schema.org',
				'@type': 'ClaimReview',
				url: pageURL,
				claimReviewed: title,
				author: {
					'@type': 'Organization',
					name: 'ProofNews',
					url: Astro.site?.toString(),
				},
				reviewRating: {
					'@type': 'Rating',
					ratingValue: VERDICTS[verdict as Verdict].rating,
					bestRating: 5,
					worstRating: 1,
					alternateName: verdict,
				},
			}
		: null;
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			ogType="article"
			publishedTime={pubDate.toISOString()}
			modifiedTime={(updatedDate ?? pubDate).toISOString()}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		{claimReview && <script type="application/ld+json" set:html={JSON.stringify(claimReview)} />}
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: var(--text);
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0.4em 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--muted);
				font-family: 'Atkinson Hyperlegible', system-ui, sans-serif;
			}
			.last-updated-on {
				font-style: italic;
			}
			.verdict-line {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 0.75em;
				flex-wrap: wrap;
				margin-bottom: 0.5em;
				font-family: 'Atkinson Hyperlegible', system-ui, sans-serif;
			}
			.verdict-label {
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--muted);
			}
			.category-line {
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--accent);
				font-family: 'Atkinson Hyperlegible', system-ui, sans-serif;
			}
			/* Reserve space for article images before they load so the page
			   never jumps (zero Cumulative Layout Shift). */
			.prose picture {
				display: block;
			}
			.prose img {
				width: 100%;
				height: auto;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border-radius: 12px;
			}
			/* Image captions sit in a paragraph of their own right after the
			   image: center them and tone them down. */
			.prose p > em:only-child {
				display: block;
				text-align: center;
				font-size: 0.85rem;
				color: var(--muted);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)}
						</div>
						{category && <div class="category-line">{category}</div>}
						<h1>{title}</h1>
						{verdict && verdict in VERDICTS && (
							<div class="verdict-line">
								<span class="verdict-label">Our verdict</span>
								<VerdictBadge verdict={verdict as Verdict} />
							</div>
						)}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
