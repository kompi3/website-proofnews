---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import { SITE_DESCRIPTION, SITE_TITLE, VERDICTS, type Verdict } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 6);

const categories = [
	{
		name: 'Health',
		desc: 'Wellness myths & medical claims, checked',
		img: '1505751172876-fa1923c5c528',
	},
	{
		name: 'Technology',
		desc: 'AI rumors, gadgets & digital scares',
		img: '1518770660439-4636190af475',
	},
	{
		name: 'Science',
		desc: 'Space myths & science misconceptions',
		img: '1451187580459-43490279c0fa',
	},
	{
		name: 'Viral Claims',
		desc: 'Trending posts, put to the test',
		img: '1511707171634-5f897ff02aa9',
	},
];

const thumbsByCat: Record<string, string[]> = {
	Health: ['1505751172876-fa1923c5c528', '1512621776951-a57141f2eefd', '1576091160550-2173dba999ef'],
	Technology: ['1518770660439-4636190af475', '1511707171634-5f897ff02aa9', '1677442136019-21780ecad995'],
	Science: ['1451187580459-43490279c0fa', '1462331940025-496dfbfc7564', '1502134249126-9f3755a50d78'],
	'Viral Claims': ['1594663653925-365bcbf7ef86', '1526304640581-d334cdbbf45e', '1526374965328-7f61d4dc18c5'],
};
const thumbFor = (post: (typeof posts)[number], i: number) => {
	const list = thumbsByCat[post.data.category] ?? Object.values(thumbsByCat).flat();
	return list[i % list.length];
};

const verdictOrder: Verdict[] = ['True', 'Mostly True', 'Misleading', 'False', 'Unproven'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: SITE_TITLE,
				url: 'https://ProofNews.biz.id/',
				description: SITE_DESCRIPTION,
			})}
		/>
		<style>
			.hero {
				text-align: center;
				padding: 6em 1.5em 5em;
			}
			.hero-inner {
				width: 860px;
				max-width: 100%;
				margin: 0 auto;
			}
			.hero h1 {
				font-size: 3.4em;
				margin-bottom: 0.4em;
			}
			.hero p.lead {
				font-size: 1.2rem;
				max-width: 62ch;
				margin: 0 auto 2.2em;
			}
			.stats {
				display: flex;
				justify-content: center;
				gap: 3em;
				flex-wrap: wrap;
				margin-bottom: 2.5em;
			}
			.stat strong {
				display: block;
				font-size: 1.9em;
				color: var(--accent);
				line-height: 1.1;
				font-family: var(--serif);
			}
			.stat span {
				font-size: 0.9rem;
				color: var(--muted);
				text-transform: uppercase;
				letter-spacing: 0.12em;
			}
			.hero-cta {
				display: flex;
				gap: 1em;
				justify-content: center;
				flex-wrap: wrap;
			}

			.legend-grid {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				gap: 1rem;
			}
			.legend-card {
				text-align: center;
				padding: 1.5em 1em;
			}
			.legend-card p {
				font-size: 0.88rem;
				margin: 0.8em 0 0;
			}

			.cat-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1.25rem;
			}
			.cat-card {
				position: relative;
				display: block;
				border-radius: var(--radius);
				overflow: hidden;
				border: 1px solid var(--border);
				aspect-ratio: 4 / 5;
				transition:
					transform 0.2s ease,
					border-color 0.2s ease;
			}
			.cat-card:hover {
				transform: translateY(-4px);
				border-color: rgba(22, 101, 52, 0.5);
			}
			.cat-card img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
			}
			.cat-card::after {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(to top, rgba(20, 28, 20, 0.88) 0%, rgba(20, 28, 20, 0.12) 60%);
			}
			.cat-label {
				position: absolute;
				left: 1.1em;
				right: 1.1em;
				bottom: 1.1em;
				z-index: 1;
			}
			.cat-label strong {
				display: block;
				color: #fff;
				font-size: 1.25rem;
				font-family: var(--serif);
			}
			.cat-label span {
				color: rgba(255, 255, 255, 0.8);
				font-size: 0.85rem;
			}

			.article-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.25rem;
			}
			.article-card .date {
				font-size: 0.82rem;
				color: var(--muted);
				text-transform: uppercase;
				letter-spacing: 0.1em;
				margin-bottom: 0.5em;
			}
			.article-card h3 {
				line-height: 1.3;
			}
			.article-card h3 a {
				color: var(--text);
			}
			.article-card h3 a:hover {
				color: var(--accent);
			}
			.card-top {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.75em;
				margin-bottom: 0.9em;
			}

			.cta-band {
				background:
					radial-gradient(800px 300px at 50% 0%, rgba(22, 101, 52, 0.08), transparent),
					var(--bg-soft);
				border-top: 1px solid var(--border);
				border-bottom: 1px solid var(--border);
				text-align: center;
			}
			.cta-band h2 {
				font-size: 2.4em;
				margin-bottom: 0.35em;
			}
			.cta-band p {
				max-width: 60ch;
				margin: 0 auto 2em;
				font-size: 1.1rem;
			}

			@media (max-width: 900px) {
				.cat-grid {
					grid-template-columns: repeat(2, 1fr);
				}
				.article-grid {
					grid-template-columns: repeat(2, 1fr);
				}
				.legend-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 720px) {
				.hero {
					padding: 4em 1.25em 3.5em;
				}
				.hero h1 {
					font-size: 2.3em;
				}
				.stats {
					gap: 1.5em;
				}
				.article-grid {
					grid-template-columns: 1fr;
				}
				.cat-card {
					aspect-ratio: 16 / 10;
				}
				.legend-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />

		<main>
		<section class="hero paper-grain">
			<div class="hero-inner">
				<span class="eyebrow">Evidence-Based Fact-Checking</span>
				<h1>Don't Share It Until <em>We Check It</em></h1>
				<p class="lead">
					{SITE_DESCRIPTION} Every claim is traced to its source, weighed against the
					evidence, and stamped with a clear verdict.
				</p>
				<div class="stats">
					<div class="stat"><strong>{posts.length}</strong><span>Fact-Checks</span></div>
					<div class="stat"><strong>5</strong><span>Verdict Levels</span></div>
					<div class="stat"><strong>4</strong><span>Categories</span></div>
				</div>
				<div class="hero-cta">
					<a class="btn btn-primary" href="/blog">Read the Fact-Checks</a>
					<a class="btn btn-ghost" href="/about">How We Check</a>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-inner">
				<div class="section-head">
					<span class="eyebrow">How We Rate Claims</span>
					<h2>Our <em>Verdict</em> Scale</h2>
					<p>Every investigation ends with one of five verdicts — no hedging, no jargon.</p>
				</div>
				<div class="legend-grid">
					{
						verdictOrder.map((v) => (
							<div class="card legend-card">
								<VerdictBadge verdict={v} />
								<p>{VERDICTS[v].blurb}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="section" style="background: var(--bg-soft); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
			<div class="section-inner">
				<div class="section-head">
					<span class="eyebrow">Browse by Category</span>
					<h2>What Should We <em>Check</em> Next?</h2>
					<p>Jump into the claims people are sharing most right now.</p>
				</div>
				<div class="cat-grid">
					{
						categories.map((c) => (
							<a class="cat-card" href="/blog">
								<ResponsiveImage id={c.img} alt="" loading="lazy" />
								<span class="cat-label">
									<strong>{c.name}</strong>
									<span>{c.desc}</span>
								</span>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-inner">
				<div class="section-head">
					<span class="eyebrow">Fresh Off the Desk</span>
					<h2>Latest <em>Fact-Checks</em></h2>
				</div>
				<div class="article-grid">
					{
						latest.map((post, i) => (
							<article class="card article-card">
								<a href={`/blog/${post.id}/`} aria-label={post.data.title}>
									<ResponsiveImage id={thumbFor(post, i)} alt="" loading="lazy" />
								</a>
								<div class="card-body">
									<div class="card-top">
										<div class="date">
											<FormattedDate date={post.data.pubDate} />
										</div>
										{post.data.verdict && post.data.verdict in VERDICTS && (
											<VerdictBadge verdict={post.data.verdict as Verdict} />
										)}
									</div>
									<h3>
										<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									</h3>
									<p>{post.data.description}</p>
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="section cta-band">
			<div class="section-inner">
				<span class="eyebrow">Seen Something Dubious?</span>
				<h2>Send Us a <em>Claim</em> to Check</h2>
				<p>
					Spotted a viral post, a health tip, or a tech rumor that smells off? Send it our
					way — we'll trace it to the source and publish the verdict.
				</p>
				<a class="btn btn-primary" href="/contact">Submit a Claim</a>
			</div>
		</section>
		</main>

		<Footer />
	</body>
</html>
