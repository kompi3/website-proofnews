---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import { SITE_DESCRIPTION, SITE_TITLE, VERDICTS, type Verdict } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const thumbsByCat: Record<string, string[]> = {
	Health: ['1505751172876-fa1923c5c528', '1512621776951-a57141f2eefd', '1576091160550-2173dba999ef'],
	Technology: ['1518770660439-4636190af475', '1511707171634-5f897ff02aa9', '1677442136019-21780ecad995'],
	Science: ['1451187580459-43490279c0fa', '1462331940025-496dfbfc7564', '1502134249126-9f3755a50d78'],
	'Viral Claims': ['1594663653925-365bcbf7ef86', '1526304640581-d334cdbbf45e', '1526374965328-7f61d4dc18c5'],
};
const thumbFor = (post: (typeof posts)[number], i: number) => {
	const list = thumbsByCat[post.data.category] ?? Object.values(thumbsByCat).flat();
	return list[i % list.length];
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Fact-Checks — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.page-head {
				text-align: center;
				padding: 3.5em 1em 1em;
			}
			.page-head h1 {
				font-size: 2.8em;
				margin-bottom: 0.3em;
			}
			.page-head p {
				font-size: 1.1rem;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5rem;
				list-style: none;
				margin: 0;
				padding: 2em 0 3em;
			}
			.grid .date {
				font-size: 0.82rem;
				color: var(--muted);
				text-transform: uppercase;
				letter-spacing: 0.1em;
				margin-bottom: 0.5em;
			}
			.grid h2 {
				font-size: 1.45rem;
				line-height: 1.3;
			}
			.grid h2 a {
				color: var(--text);
			}
			.grid h2 a:hover {
				color: var(--accent);
			}
			.badge {
				display: inline-block;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--accent);
				border: 1px solid rgba(22, 101, 52, 0.4);
				border-radius: 999px;
				padding: 0.25em 0.9em;
				margin-bottom: 0.9em;
			}
			.card-top {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.75em;
				flex-wrap: wrap;
				margin-bottom: 0.9em;
			}
			@media (max-width: 720px) {
				.grid {
					grid-template-columns: 1fr;
				}
				.page-head h1 {
					font-size: 2.1em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main style="width: 1020px;">
			<div class="page-head">
				<span class="eyebrow">Every Claim, Checked</span>
				<h1>All <em>Fact-Checks</em></h1>
				<p>Viral claims, health myths, and tech rumors — investigated and rated.</p>
			</div>
			<section>
				<ul class="grid">
					{
						posts.map((post, i) => (
							<li>
								<article class="card">
									<a href={`/blog/${post.id}/`} aria-label={post.data.title}>
										<ResponsiveImage id={thumbFor(post, i)} alt="" loading="lazy" />
									</a>
									<div class="card-body">
										<div class="card-top">
											<div>
												{post.data.category && (
													<span class="badge">{post.data.category}</span>
												)}
											</div>
											{post.data.verdict && post.data.verdict in VERDICTS && (
												<VerdictBadge verdict={post.data.verdict as Verdict} />
											)}
										</div>
										<div class="date">
											<FormattedDate date={post.data.pubDate} />
										</div>
										<h2>
											<a href={`/blog/${post.id}/`}>{post.data.title}</a>
										</h2>
										<p>{post.data.description}</p>
									</div>
								</article>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
